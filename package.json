{
  "name": "nx1",
  "version": "0.4.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next out build dist coverage test-results playwright-report playwright/.cache .vitest vitest-results .cache .temp .tmp dist-ssr && find . -name '*.tsbuildinfo' -not -path './node_modules/*' -delete",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/playwright-preflight.mjs && node scripts/playwright-run.mjs",
    "test:e2e:ui": "node scripts/playwright-run.mjs --ui",
    "test:e2e:headed": "node scripts/playwright-run.mjs --headed",
    "demo:record": "npm run demo:screenshots",
    "demo:screenshots": "npm run demo:setup-readme && npm run demo:setup && node scripts/playwright-preflight.mjs && node scripts/playwright-run.mjs e2e/readme-screenshots.spec.ts e2e/copyall-demo.spec.ts && npm run demo:convert && npm run demo:verify",
    "demo:setup-readme": "./scripts/setup_readme_screenshots.sh",
    "demo:setup": "./scripts/setup_copyall_demo.sh --clean",
    "demo:convert": "./scripts/convert_demo_to_gif.sh",
    "demo:verify": "./scripts/verify_demo_screenshots.sh",
    "validate:vocabulary": "bash scripts/validate-vocabulary.sh"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "js-yaml": "^4.1.1",
    "next": "16.1.6",
    "path-browserify": "^1.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}

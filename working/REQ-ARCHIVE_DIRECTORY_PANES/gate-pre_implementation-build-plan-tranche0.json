  "citdp": {
    "record_identity": {
      "change_request_id": "ARCHIVE_DIRECTORY_PANES",
      "recorded_at": "2026-09-01",
      "title": "Read-only archive-backed panes with virtual directory navigation and extraction"
    },
    "change_definition": {
      "current_behavior": "Archives are opaque filesystem files; archive preview type returns stub; panes list ordinary directories only; POST /api/files mutations assume ordinary paths; no virtual locator contract.",
      "desired_behavior": "Supported archives open as read-only virtual directories in panes; entries navigate, compare, and extract to ordinary destinations; shared manifest reader replaces preview stub; archive file never mutated.",
      "non_goals": [
        "Nested archive navigation",
        "Directory or bulk tree extraction",
        "Archive creation or repacking",
        "Archive-to-archive operations",
        "Client-side parsing",
        "TAR.BZ2/7z/RAR adapters in v1",
        "NSYNC from/to archive locators"
      ],
      "success_criteria": [
        "Open, browse, compare, and extract supported archives without mutating source archive",
        "Virtual locator round-trips API, pane state, mesh restore, and URL deep links",
        "Safety limits and stable error codes for malicious/oversized/malformed archives",
        "Ordinary listing and file operations regression-covered",
        "REQ/ARCH/IMPL traceability with validated pseudo-code and integrated inquiry artifacts"
      ],
      "unchanged_behavior": "Ordinary directory listing and mutations; mesh snapshot schema version; comparison algorithms; volume stats contract for ordinary panes; display filters and cross-pane visibility"
    },
